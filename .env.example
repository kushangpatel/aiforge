# ============================================================
# AIForge — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ---- Provider Selection ----
AIFORGE_PROVIDER=openai                          # openai | anthropic | ollama | azure
AIFORGE_MODEL=gpt-4o                             # LLM model name
AIFORGE_TEMPERATURE=0                             # LLM temperature (0 = deterministic)
AIFORGE_EMBEDDING_MODEL=text-embedding-3-small    # Embedding model

# ---- OpenAI ----
AIFORGE_OPENAI_API_KEY=                           # Required if provider=openai

# ---- Anthropic ----
# AIFORGE_ANTHROPIC_API_KEY=                      # Required if provider=anthropic
# AIFORGE_VOYAGE_API_KEY=                         # Required for Anthropic embeddings (Voyage AI)

# ---- Azure OpenAI ----
# AIFORGE_AZURE_OPENAI_ENDPOINT=                  # e.g. https://your-resource.openai.azure.com/
# AIFORGE_AZURE_OPENAI_API_KEY=

# ---- Ollama (Local) ----
# AIFORGE_OLLAMA_BASE_URL=http://localhost:11434

# ---- Vector Store ----
AIFORGE_VECTOR_STORE=chroma                       # chroma | pgvector | <registered name>
AIFORGE_CHROMA_PERSIST_DIR=./aiforge_data         # ChromaDB data directory

# pgvector (only when AIFORGE_VECTOR_STORE=pgvector)
# AIFORGE_PGVECTOR_DSN=postgresql://user:pass@localhost:5432/aiforge
# AIFORGE_PGVECTOR_COLLECTION=default

# Pinecone (only when AIFORGE_VECTOR_STORE=pinecone)
# AIFORGE_PINECONE_API_KEY=
# AIFORGE_PINECONE_INDEX=
# AIFORGE_PINECONE_ENVIRONMENT is deprecated — the v3 SDK resolves the endpoint automatically.

# Qdrant (only when AIFORGE_VECTOR_STORE=qdrant)
# AIFORGE_QDRANT_URL=http://localhost:6333
# AIFORGE_QDRANT_API_KEY=
# AIFORGE_QDRANT_COLLECTION=

# ---- Observability ----
AIFORGE_TRACING_ENABLED=false                     # Enable tracing (true | false)
AIFORGE_TRACING_PROVIDER=langsmith                # langsmith | otel | console
# AIFORGE_LANGSMITH_API_KEY=                      # Required if tracing_provider=langsmith

# ---- Cost Tracking ----
AIFORGE_COST_TRACKING_ENABLED=true
AIFORGE_COST_WARN_THRESHOLD=1.00                  # Warn if single call cost > $N

# ---- Rate Limiting ----
AIFORGE_RATE_LIMIT_RPM=500                        # Requests per minute
AIFORGE_RATE_LIMIT_TPM=150000                     # Tokens per minute

# ---- API Server ----
AIFORGE_API_HOST=0.0.0.0
AIFORGE_API_PORT=8000
# AIFORGE_API_KEY=                                # Set to enable Bearer token auth on REST API

# ---- CORS (API Server) ----
AIFORGE_CORS_ORIGINS=http://localhost:8501         # Comma-separated or JSON array