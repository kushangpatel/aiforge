# ============================================================
# AIForge - Secrets & API Keys ONLY
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All non-secret configuration belongs in aiforge.yaml.
# See aiforge.yaml.example for the full list of settings.
#
# NEVER commit .env to version control.
# ============================================================

# ---- OpenAI ----
AIFORGE_OPENAI_API_KEY=

# ---- Anthropic ----
# AIFORGE_ANTHROPIC_API_KEY=
# AIFORGE_VOYAGE_API_KEY=

# ---- Azure OpenAI ----
# AIFORGE_AZURE_OPENAI_API_KEY=
# AIFORGE_AZURE_OPENAI_ENDPOINT=

# ---- Google Gemini ----
# AIFORGE_GOOGLE_API_KEY=

# ---- Mistral ----
# AIFORGE_MISTRAL_API_KEY=

# ---- Amazon Bedrock ----
# Credentials come from the standard AWS chain (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, SSO or an IAM role). Set the
# region and optional profile in aiforge.yaml (aws_region, aws_profile).

# ---- Pinecone ----
# AIFORGE_PINECONE_API_KEY=

# ---- Qdrant ----
# AIFORGE_QDRANT_API_KEY=

# ---- Tracing ----
# AIFORGE_LANGSMITH_API_KEY=

# ---- API Server Auth ----
# AIFORGE_API_KEY=
